VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_REDIRECT_URI=
VITE_POST_LOGOUT_REDIRECT_URI=
VITE_COGNITO_LOGOUT_URI=
VITE_API_BASE_URL=http://localhost:8080

# Versión de esta build (1, 2 o 3) y URLs de las 3 versiones desplegadas
VITE_APP_VERSION=3
VITE_VERSION_1_URL=https://ticketfilms-v1.vercel.app
VITE_VERSION_2_URL=https://ticket-films-v2.vercel.app
VITE_VERSION_3_URL=https://ticket-films-frontend.vercel.app
# Control de versiones: grupo de Cognito que da acceso a ESTA versión
VITE_VERSION_GROUP=version1
